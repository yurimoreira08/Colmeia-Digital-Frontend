    "@react-navigation/native": "^7.2.0",
    "@react-navigation/native-stack": "^7.14.8",
    "@types/jest": "29.5.14",
    "eslint-config-expo": "~10.0.0",
    "expo": "^54.0.35",
    "expo-constants": "~18.0.8",
    "expo-crypto": "~15.0.9",
    "expo-file-system": "^19.0.23",
    "expo-font": "^14.0.12",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-media-library": "~18.2.1",
    "expo-notifications": "^0.32.17",
    "expo-print": "~15.0.8",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-speech-recognition": "^3.1.2",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.18",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/react": "~19.1.10",
    "better-sqlite3": "^13.2.0",
    "eslint": "^9.39.5",
    "test-renderer": "^1.3.1",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=22.18.0",
    "npm": ">=11.0.0"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/tests/**/*.test.ts?(x)"
    ],
    "moduleNameMapper": {
      "^@react-native-async-storage/async-storage$": "<rootDir>/node_modules/@react-native-async-storage/async-storage/jest/async-storage-mock"
    }
  },
  "packageManager": "npm@11.6.1"
}
